APP_NAME="HairCut Home Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Correos con Resend (plantilla de marca)
MESSAGING_DRIVER=http
MESSAGING_API_KEY=
MESSAGING_API_URL=https://api.resend.com/emails
MESSAGING_FROM=onboarding@resend.dev
MESSAGING_FROM_NAME="HairCut Home Studio"
MESSAGING_SOFT_FAIL=true
# Sin dominio verificado, Resend solo entrega a este correo (cuenta Resend).
MESSAGING_OVERRIDE_TO=
RESEND_API_KEY=
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="${APP_NAME}"
